{
  "name": "clocktowertimer",
  "version": "1.2.11",
  "description": "Clock Tower Timer Application",
  "scripts": {
    "stamp-release": "node scripts/release-assets.mjs --write",
    "test": "start-server-and-test 'npx serve -l 8006' http://localhost:8006 'cypress run'",
    "test:open": "start-server-and-test 'npx serve -l 8006' http://localhost:8006 'cypress open'",
    "test:unit": "node --test test/*.test.mjs",
    "test:worker": "vitest run --config worker/vitest.config.js",
    "test:integration": "start-server-and-test 'npm run dev:worker' http://127.0.0.1:8787/health 'npm run dev:timer' http://127.0.0.1:8006 'cypress run --config specPattern=cypress/integration/**/*.cy.js'",
    "dev:worker": "WRANGLER_SEND_METRICS=false wrangler dev --config worker/wrangler.jsonc --port 8787 --ip 127.0.0.1",
    "dev:timer": "node scripts/dev-server.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "cypress": "^16.1.0",
    "serve": "^14.2.6",
    "start-server-and-test": "^3.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.150.0"
  },
  "overrides": {
    "compression": "^1.8.2"
  },
  "allowScripts": {
    "cypress@16.1.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
