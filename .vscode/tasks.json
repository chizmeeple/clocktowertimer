{
  "version": "2.0.0",
  "options": {
    "env": {
      "COMPANION_WORKER_URL": "https://clocktower-companion.redmeeple.workers.dev"
    }
  },
  "tasks": [
    {
      "label": "Startup tasks",
      "dependsOn": ["Open Regular Terminal", "dev:timer"],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "develop"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "Simple Web Server",
      "type": "shell",
      "command": "python3 -m http.server 8000",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "startup"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "dev:timer",
      "type": "shell",
      "command": "npm run dev:timer",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "startup"
      }
    },
    {
      "label": "Open Regular Terminal",
      "type": "shell",
      "command": "/usr/bin/env zsh",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "startup"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
